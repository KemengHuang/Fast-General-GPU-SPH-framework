__device__ __forceinline__
void computeNeighborCellInfoReg(
    int cell_idx,
    const ushort3 &cellpos,
    int minx, int maxx, int minz, int maxz,
    const int * __restrict__ cell_offset_M,
    const int * __restrict__ cell_offset,
    const int * __restrict__ cell_num,
    const ushort3 &grid_size,
    int &out_offset, int &out_nump, int &out_begin)
{
    int dy = cell_idx % 3 - 1;
    int dz = (cell_idx / 3) % 3 - 1;
    ushort3 neighbor_pos = cellpos + make_ushort3(-1, dy, dz);
    if (neighbor_pos.y < 0 || neighbor_pos.y >= grid_size.y ||
        neighbor_pos.z < 0 || neighbor_pos.z >= grid_size.z) {
        out_offset = 0;
        out_nump = 0;
        out_begin = -1;
        return;
    }

    int nid_left = CellPos2CellIdx(neighbor_pos, grid_size);
    ++neighbor_pos.x;
    int nid_mid = CellPos2CellIdx(neighbor_pos, grid_size);
    ++neighbor_pos.x;
    int nid_right = CellPos2CellIdx(neighbor_pos, grid_size);

    out_offset = (kInvalidCellIdx == nid_left)
        ? __ldg(&cell_offset[nid_mid])
        : __ldg(&cell_offset_M[(nid_left << 6) + (minx << 4)]);

    int my_cell_nump = __ldg(&cell_num[nid_mid]);
    if (kInvalidCellIdx != nid_left) {
        my_cell_nump += __ldg(&cell_offset[nid_mid]) - __ldg(&cell_offset_M[(nid_left << 6) + (minx << 4)]);
    }
    if (maxx == 3) {
        if (kInvalidCellIdx != nid_right) {
            my_cell_nump += __ldg(&cell_num[nid_right]);
        }
    } else {
        if (kInvalidCellIdx != nid_right) {
            my_cell_nump += __ldg(&cell_offset_M[(nid_right << 6) + ((maxx + 1) << 4)])
                           - __ldg(&cell_offset_M[(nid_right << 6)]);
        }
    }

    int leftl = (kInvalidCellIdx == nid_left ? 0 : 4 - minx);
    int rightl = (kInvalidCellIdx == nid_right ? 0 : 1 + maxx);
    int leng = 4 + leftl + rightl;

    int begin_ = -1;
    if (my_cell_nump > leng * 22) {
        if ((minz > 0) && ((cell_idx % 9) < 3)) {
            begin_ = (kInvalidCellIdx == nid_left)
                ? (nid_mid << 6)
                : ((nid_left << 6) + (minx << 4));
            if (my_cell_nump > 0) {
                int lay = 0;
                while ((__ldg(&cell_offset_M[begin_ + ((lay + 1) << 4)]) -
                        __ldg(&cell_offset_M[begin_ + (minz << 2) + (lay << 4)])) == 0) {
                    ++lay;
                    if (lay >= leng) { my_cell_nump = 0; break; }
                }
            }
        }
        else if ((maxz < 3) && ((cell_idx % 9) > 5)) {
            begin_ = (kInvalidCellIdx == nid_left)
                ? (nid_mid << 6)
                : ((nid_left << 6) + (minx << 4));
            if (my_cell_nump > 0) {
                int lay = 0;
                while ((__ldg(&cell_offset_M[begin_ + (lay << 4) + ((maxz + 1) << 2)]) -
                        __ldg(&cell_offset_M[begin_ + (lay << 4)])) == 0) {
                    ++lay;
                    if (lay >= leng) { my_cell_nump = 0; break; }
                }
            }
        }
    }

    out_nump = my_cell_nump;
    out_begin = begin_;
}

